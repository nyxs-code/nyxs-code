{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permisos por defecto para Nyxs",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-request-user-attention",
    "core:window:allow-set-focus",
    "core:webview:allow-set-webview-focus",
    "dialog:default",
    "notification:default",
    "updater:default",
    "process:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://*:*/*"
        },
        {
          "url": "http://localhost:*/*"
        },
        {
          "url": "http://*.localhost:*/*"
        },
        {
          "url": "http://*.local:*/*"
        },
        {
          "url": "http://(127\\.\\d{1,3}\\.\\d{1,3}\\.\\d{1,3}):*/*"
        },
        {
          "url": "http://(10\\.\\d{1,3}\\.\\d{1,3}\\.\\d{1,3}):*/*"
        },
        {
          "url": "http://(192\\.168\\.\\d{1,3}\\.\\d{1,3}):*/*"
        },
        {
          "url": "http://(172\\.(?:1[6-9]|2\\d|3[01])\\.\\d{1,3}\\.\\d{1,3}):*/*"
        }
      ],
      "deny": [
        {
          "url": "http://(169\\.254\\.\\d{1,3}\\.\\d{1,3}):*/*"
        },
        {
          "url": "https://(169\\.254\\.\\d{1,3}\\.\\d{1,3}):*/*"
        },
        {
          "url": "http://metadata.google.internal:*/*"
        },
        {
          "url": "https://metadata.google.internal:*/*"
        },
        {
          "url": "http://(\\[::ffff:a9fe:[0-9a-f]{1,4}\\]):*/*"
        },
        {
          "url": "https://(\\[::ffff:a9fe:[0-9a-f]{1,4}\\]):*/*"
        },
        {
          "url": "http://(\\[fe[89ab][0-9a-f]:[0-9a-f:]*\\]):*/*"
        },
        {
          "url": "https://(\\[fe[89ab][0-9a-f]:[0-9a-f:]*\\]):*/*"
        },
        {
          "url": "http://(\\[fd00:ec2::254\\]):*/*"
        },
        {
          "url": "https://(\\[fd00:ec2::254\\]):*/*"
        }
      ]
    },
    "deep-link:default"
  ]
}
